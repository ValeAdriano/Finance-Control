# Supabase (Fase 2) — as duas primeiras sao expostas ao browser, as demais NAO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave usada para criptografar tokens de terceiros antes de gravar no banco.
# Gerar com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# brapi.dev — cotacao e fundamentos de acoes/FIIs (Fase 3)
BRAPI_TOKEN=

# Pluggy / Meu Pluggy — Open Finance (Fase 3)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Fonte usada apenas em dev. "mock" | "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock
