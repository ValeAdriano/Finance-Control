{
  "expo": {
    "name": "Bullz",
    "slug": "bullz-finance-tracker",
    "scheme": "bullz",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.agvs.bullz"
    },
    "android": {
      "package": "br.com.agvs.bullz",
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/app/android-frente.png",
        "backgroundImage": "./assets/img/app/android-fundo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/img/icone-192.png",
      "name": "Bullz",
      "shortName": "Bullz",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "O Bullz usa o Face ID para desbloquear o app e proteger sua carteira." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/img/app/icone-app-1024.png",
    "splash": {
      "image": "./assets/img/icone-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    }
  }
}
